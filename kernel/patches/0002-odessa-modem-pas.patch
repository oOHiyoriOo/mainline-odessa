diff -Naur a/drivers/soc/qcom/odessa_glink.c b/drivers/soc/qcom/odessa_glink.c
--- a/drivers/soc/qcom/odessa_glink.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/soc/qcom/odessa_glink.c	2026-11-08 12:55:15.633254842 +0000
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * odessa: instantiate the modem GLINK edge without an SM6150 remoteproc
+ * driver. The modem is already booted by ABL; this only brings up the
+ * SMEM/mailbox transport so that rpmsg channels (IPCRTR -> QRTR) exist.
+ */
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/rpmsg/qcom_glink.h>
+#include <linux/slab.h>
+
+struct odessa_glink {
+	struct qcom_glink_smem *smem;
+	struct device_node *node;
+};
+
+static int odessa_glink_probe(struct platform_device *pdev)
+{
+	struct odessa_glink *g;
+
+	g = devm_kzalloc(&pdev->dev, sizeof(*g), GFP_KERNEL);
+	if (!g)
+		return -ENOMEM;
+
+	g->node = of_get_next_child(pdev->dev.of_node, NULL);
+	if (!g->node)
+		return -ENODEV;
+
+	g->smem = qcom_glink_smem_register(&pdev->dev, g->node);
+	if (IS_ERR(g->smem)) {
+		of_node_put(g->node);
+		return PTR_ERR(g->smem);
+	}
+
+	platform_set_drvdata(pdev, g);
+	dev_info(&pdev->dev, "modem GLINK edge registered\n");
+	return 0;
+}
+
+static void odessa_glink_remove(struct platform_device *pdev)
+{
+	struct odessa_glink *g = platform_get_drvdata(pdev);
+
+	qcom_glink_smem_unregister(g->smem);
+	of_node_put(g->node);
+}
+
+static const struct of_device_id odessa_glink_of_match[] = {
+	{ .compatible = "odessa,glink-edge" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, odessa_glink_of_match);
+
+static struct platform_driver odessa_glink_driver = {
+	.probe = odessa_glink_probe,
+	.remove_new = odessa_glink_remove,
+	.driver = {
+		.name = "odessa-glink",
+		.of_match_table = odessa_glink_of_match,
+	},
+};
+builtin_platform_driver(odessa_glink_driver);
+
+MODULE_DESCRIPTION("Odessa modem GLINK edge");
+MODULE_LICENSE("GPL");
