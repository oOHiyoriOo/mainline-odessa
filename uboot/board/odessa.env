bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# save_prev_bl_data overwrites this with ABL's /chosen/linux,initrd-start.
prevbl_initrd_start_addr=0x85367000

# ABL places the ramdisk/FIT at a kernel-size-dependent address. Try the
# ABL-provided address first, then likely fallbacks. iminfo only boots a
# valid FIT/kernel image.
bootcmd=run serial_gadget; for addr in ${prevbl_initrd_start_addr} 0x81000000 0x82000000 0x83000000 0x84000000 0x85000000 0x85367000 0x86000000 0x87000000; do if iminfo $addr; then bootm $addr; fi; done

# Shortcut to enable the USB ACM serial gadget.
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout serial,vidconsole,usbacm; setenv stderr serial,vidconsole,usbacm; setenv bootretry -1; echo Enabled U-Boot console serial gadget

# Menu (reachable via the phone key remap / failed boot).
menucmd=setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=Boot FIT=for addr in ${prevbl_initrd_start_addr} 0x81000000 0x82000000 0x83000000 0x84000000 0x85000000 0x85367000 0x86000000 0x87000000; do if iminfo $addr; then bootm $addr; fi; done
bootmenu_1=Enable serial console gadget=run serial_gadget
bootmenu_2=Enable fastboot mode=echo "Press any key to enter fastboot"; run fastboot
bootmenu_3=Drop to shell=setenv bootretry -1
bootmenu_4=Reset device=reset

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
