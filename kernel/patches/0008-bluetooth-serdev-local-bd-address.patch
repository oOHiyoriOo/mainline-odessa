--- a/drivers/bluetooth/hci_serdev.c
+++ b/drivers/bluetooth/hci_serdev.c
@@ -14,6 +14,7 @@
 #include <linux/kernel.h>
 #include <linux/types.h>
 #include <linux/serdev.h>
+#include <linux/property.h>
 #include <linux/skbuff.h>
 
 #include <net/bluetooth/bluetooth.h>
@@ -360,6 +361,13 @@
 	if (test_bit(HCI_UART_NO_SUSPEND_NOTIFIER, &hu->flags))
 		set_bit(HCI_QUIRK_NO_SUSPEND_NOTIFIER, &hdev->quirks);
 
+	/* Controllers that do not report a valid BD address (WCN3990) have to
+	 * take it from the device tree; hci_dev_setup_sync() then programs it
+	 * during the setup instead of marking the controller unconfigured.
+	 */
+	if (device_property_present(&hu->serdev->dev, "local-bd-address"))
+		set_bit(HCI_QUIRK_USE_BDADDR_PROPERTY, &hdev->quirks);
+
 	if (test_bit(HCI_UART_RAW_DEVICE, &hu->hdev_flags))
 		set_bit(HCI_QUIRK_RAW_DEVICE, &hdev->quirks);
 
