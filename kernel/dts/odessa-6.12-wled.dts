		pinctrl@3400000 {
			compatible = "qcom,sdmmagpie-pinctrl";
			reg = <0x3400000 0xdc2000 0x17c000f0 0x60>;
			reg-names = "pinctrl\0spi_cfg";
			interrupts = <0x00 0xd0 0x00>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x178>;

			ufs_dev_reset_assert {
				phandle = <0x9e>;

				config {
					pins = "ufs_reset";
					bias-pull-down;
					drive-strength = <0x08>;
					output-low;
				};
			};

			ufs_dev_reset_deassert {
				phandle = <0x9f>;

				config {
					pins = "ufs_reset";
					bias-pull-down;
					drive-strength = <0x08>;
					output-high;
				};
			};

			qupv3_se0_i2c_pins {
				phandle = <0x39d>;

				qupv3_se0_i2c_active {
					phandle = <0x16a>;

					mux {
						pins = "gpio49\0gpio50";
						function = "qup00";
					};

					config {
						pins = "gpio49\0gpio50";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				qupv3_se0_i2c_sleep {
					phandle = <0x16b>;

					mux {
						pins = "gpio49\0gpio50";
						function = "gpio";
					};

					config {
						pins = "gpio49\0gpio50";
						drive-strength = <0x02>;
						bias-pull-up;
					};
				};
			};

			qupv3_se0_spi_pins {
				phandle = <0x39e>;

				qupv3_se0_spi_active {
					phandle = <0x17c>;

					mux {
						pins = "gpio49\0gpio50\0gpio51\0gpio52";
						function = "qup00";
					};

					config {
						pins = "gpio49\0gpio50\0gpio51\0gpio52";
						drive-strength = <0x06>;
						bias-disable;
					};
				};

				qupv3_se0_spi_sleep {
					phandle = <0x17d>;

					mux {
						pins = "gpio49\0gpio50\0gpio51\0gpio52";
						function = "gpio";
