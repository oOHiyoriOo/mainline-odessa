[Unit]
Description=Odessa Wi-Fi (wpa_supplicant + DHCP on wlan0)
Documentation=file:/etc/wpa_supplicant.conf
After=odessa-fw-provision.service pd-mapper.service odessa-modem.service network.target
Wants=odessa-modem.service network.target
# timesyncd starts only after the link has a default route
Before=systemd-timesyncd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/odessa-wlan-up.sh
# udhcpc keeps renewing in the background: do not take it down with the unit
KillMode=process
TimeoutStartSec=240
ExecStop=-/bin/sh -c 'kill $(cat /run/udhcpc.wlan0.pid) 2>/dev/null; /usr/local/bin/busybox pkill -x wpa_supplicant'

[Install]
WantedBy=multi-user.target
