--- a/arch/arm64/boot/dts/qcom/sm6150-moto-odessa.dts	1970-01-01 00:00:00.000000000 +0000
+++ b/arch/arm64/boot/dts/qcom/sm6150-moto-odessa.dts	2026-11-07 11:57:27.442086476 +0000
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Motorola Moto G9 Plus (odessa, XT2087-2) — M0 bring-up board DTS.
+ *
+ * Memory map from /proc/iomem of the running device; reserved regions from
+ * downstream sdmmagpie.dtsi and moto-mem-reserve.h.
+ * M0 scope: boot + console. No UFS, no USB, no clocks yet.
+ */
+
+/dts-v1/;
+
+#include "sm6150.dtsi"
+
+/ {
+	model = "Motorola Moto G9 Plus (odessa)";
+	compatible = "qcom,sm6150-moto-odessa", "qcom,sdmmagpie", "qcom,sm6150";
+
+	/* Bootloader-DTB-Matching (Werte aus dem Stock-DTB) */
+	qcom,msm-id = <0x16d 0x00>;
+	qcom,msm-name = "SDMMAGPIE";
+	qcom,board-id = <0x00 0x00>;
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* Bootloader-initialized splash framebuffer (cont_splash_region) */
+		framebuffer: framebuffer@9c000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x9c000000 0x0 (2400 * 1080 * 4)>;
+			width = <1080>;
+			height = <2400>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		framebuffer_region: memory@9c000000 {
+			reg = <0x0 0x9c000000 0x0 0x1700000>;
+			no-map;
+		};
+
+		/* Moto bootloader ramoops (moto-mem-reserve.h) */
+		ramoops: ramoops@af000000 {
+			compatible = "ramoops";
+			reg = <0x0 0xaf000000 0x0 0xbf800>;
+			console-size = <0x40000>;
+			pmsg-size = <0x40000>;
+			record-size = <0x3f800>;
+			no-map;
+		};
+	};
+
+	/* Usable System RAM ranges as reported by the vendor kernel */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x5700000>;
+	};
+
+	memory@85d00000 {
+		device_type = "memory";
+		reg = <0x0 0x85d00000 0x0 0x100000>;
+	};
+
+	memory@8a300000 {
+		device_type = "memory";
+		reg = <0x0 0x8a300000 0x0 0x800000>;
+	};
+
+	memory@97717000 {
+		device_type = "memory";
+		reg = <0x0 0x97717000 0x0 0x6ce9000>;
+	};
+
+	memory@9f800000 {
+		device_type = "memory";
+		reg = <0x0 0x9f800000 0x0 0x5701000>;
+	};
+
+	memory@af0c0000 {
+		device_type = "memory";
+		reg = <0x0 0xaf0c0000 0x0 0xced40000>;
+	};
+};
