+++ b/drivers/power/supply/odessa_chg.c	2026-11-08 13:54:59.829353032 +0000
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * odessa: minimal PM6150 (SMB5) charge enable control.
+ *
+ * The vendor SMB5 driver toggles charging through CHARGING_ENABLE_CMD
+ * (CHGR_BASE 0x1000 + 0x42, BIT(0)). That is the only register needed for a
+ * charge limit; capacity comes from the QG SDAM block via nvmem.
+ */
+#include <linux/bitops.h>
+#include <linux/device.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/sysfs.h>
+
+#define ODESSA_CHG_EN_REG	0x1042
+#define ODESSA_CHG_EN_BIT	BIT(0)
+
+struct odessa_chg {
+	struct regmap *regmap;
+};
+
+static ssize_t charge_enable_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct odessa_chg *chg = dev_get_drvdata(dev);
+	unsigned int val;
+	int ret;
+
+	ret = regmap_read(chg->regmap, ODESSA_CHG_EN_REG, &val);
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf, "%u\n", !!(val & ODESSA_CHG_EN_BIT));
+}
+
+static ssize_t charge_enable_store(struct device *dev,
+				   struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct odessa_chg *chg = dev_get_drvdata(dev);
+	bool enable;
+	int ret;
+
+	ret = kstrtobool(buf, &enable);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(chg->regmap, ODESSA_CHG_EN_REG,
+				 ODESSA_CHG_EN_BIT,
+				 enable ? ODESSA_CHG_EN_BIT : 0);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "charging %s\n", enable ? "enabled" : "disabled");
+	return count;
+}
+static DEVICE_ATTR_RW(charge_enable);
+
+#define ODESSA_CHG_STATUS_REG	0x1006
+#define ODESSA_CHG_INHIBIT_REG	0x1051
+#define ODESSA_CHG_INHIBIT_BIT	BIT(0)
+
+static ssize_t status_show(struct device *dev, struct device_attribute *attr,
+			   char *buf)
+{
+	struct odessa_chg *chg = dev_get_drvdata(dev);
+	unsigned int val;
+	int ret;
+
+	ret = regmap_read(chg->regmap, ODESSA_CHG_STATUS_REG, &val);
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, "%u\n", val & 0x7);
+}
+static DEVICE_ATTR_RO(status);
+
+static ssize_t charge_inhibit_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	struct odessa_chg *chg = dev_get_drvdata(dev);
+	unsigned int val;
+	int ret;
+
+	ret = regmap_read(chg->regmap, ODESSA_CHG_INHIBIT_REG, &val);
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, "%u\n", !!(val & ODESSA_CHG_INHIBIT_BIT));
+}
+
+static ssize_t charge_inhibit_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	struct odessa_chg *chg = dev_get_drvdata(dev);
+	bool inhibit;
+	int ret;
+
+	ret = kstrtobool(buf, &inhibit);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(chg->regmap, ODESSA_CHG_INHIBIT_REG,
+				 ODESSA_CHG_INHIBIT_BIT,
+				 inhibit ? ODESSA_CHG_INHIBIT_BIT : 0);
+	if (ret)
+		return ret;
+	return count;
+}
+static DEVICE_ATTR_RW(charge_inhibit);
+
+static struct attribute *odessa_chg_attrs[] = {
+	&dev_attr_charge_enable.attr,
+	&dev_attr_charge_inhibit.attr,
+	&dev_attr_status.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(odessa_chg);
+
+static int odessa_chg_probe(struct platform_device *pdev)
+{
+	struct odessa_chg *chg;
+	struct regmap *regmap;
+
+	regmap = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!regmap)
+		return -ENODEV;
+
+	chg = devm_kzalloc(&pdev->dev, sizeof(*chg), GFP_KERNEL);
+	if (!chg)
+		return -ENOMEM;
+	chg->regmap = regmap;
+	platform_set_drvdata(pdev, chg);
+
+	dev_info(&pdev->dev, "PM6150 charge control ready\n");
+	return 0;
+}
+
+static void odessa_chg_remove(struct platform_device *pdev)
+{
+}
+
+static const struct of_device_id odessa_chg_of_match[] = {
+	{ .compatible = "odessa,charger" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, odessa_chg_of_match);
+
+static struct platform_driver odessa_chg_driver = {
+	.probe = odessa_chg_probe,
+	.remove_new = odessa_chg_remove,
+	.driver = {
+		.name = "odessa-chg",
+		.of_match_table = odessa_chg_of_match,
+		.dev_groups = odessa_chg_groups,
+	},
+};
+builtin_platform_driver(odessa_chg_driver);
+
+MODULE_DESCRIPTION("Odessa PM6150 charge enable control");
+MODULE_LICENSE("GPL");
