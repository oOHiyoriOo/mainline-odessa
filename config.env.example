# Copy to config.env, adjust, then: . ./config.env
#
# Public key baked into the initramfs (emergency SSH) and the rootfs
# (dropbear authorized_keys). Replace it for your own device.
AUTHKEY="$PWD/config/authorized_keys.pub"

# Device address on the USB-NCM link (static, no DHCP client on the host).
DEV=172.16.42.1

# Private key used by the install/snapshot scripts.
KEY="$HOME/.ssh/id_ed25519"

# Kernel/U-Boot build parallelism (nice -n 10 is applied by the scripts).
JOBS=12

# Optional: where a fetched kernel/U-Boot tree lives.
# TARBALL=/path/to/linux-6.12.tar.xz
# SRC=/path/to/u-boot-2026.10
